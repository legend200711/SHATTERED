rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Audio uploads ─────────────────────────────────────────────────────
    // Path: audio/{ownerUid}/{trackId}/{filename}
    match /audio/{ownerUid}/{trackId}/{filename} {

      // Read: any authenticated user (for streaming playback via download URL)
      allow read: if request.auth != null;

      // Write: only the owner, within size and type constraints
      allow write: if request.auth != null
        && request.auth.uid == ownerUid
        // Maximum 80 MB
        && request.resource.size <= 80 * 1024 * 1024
        // Allowed MIME types
        && request.resource.contentType.matches('audio/(mpeg|mp3|wav|x-wav|ogg|flac|x-flac|mp4|x-m4a|aac|webm)');

      // Delete: only the owner
      allow delete: if request.auth != null
        && request.auth.uid == ownerUid;
    }

    // ── Profile photos ────────────────────────────────────────────────────
    // Path: profilePhotos/{uid}/{filename}
    match /profilePhotos/{uid}/{filename} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
        && request.auth.uid == uid
        // Maximum 5 MB for profile photos
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)');

      allow delete: if request.auth != null
        && request.auth.uid == uid;
    }

    // ── Block everything else ─────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
