rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Audio uploads ─────────────────────────────────────────────────────
    // Path: audio/{ownerUid}/{trackId}/{filename}
    match /audio/{ownerUid}/{trackId}/{filename} {

      // Read: public — any visitor can stream a published track's audio.
      allow read: if true;

      // Write: only the owner, within size and type constraints.
      //
      // MIME type check:
      //   The client SDK (storage-service.js resolveContentType) always sends a
      //   proper audio/* MIME string — never an empty string or
      //   application/octet-stream — so the match below will always succeed for
      //   a validly formed upload from the SHATTERED app.
      //
      //   The broader pattern 'audio/.*' is intentionally used here so that
      //   unusual but valid MIME variants (audio/x-mp3, audio/mpeg3, etc.)
      //   accepted by the client do not cause a permission-denied at the Storage
      //   layer.  The client-side validateAudioFile() is the primary whitelist.
      allow write: if request.auth != null
        && request.auth.uid == ownerUid
        && request.resource.size <= 80 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');

      // Delete: only the owner
      allow delete: if request.auth != null
        && request.auth.uid == ownerUid;
    }

    // ── Profile photos ────────────────────────────────────────────────────
    // Path: profilePhotos/{uid}/{filename}
    match /profilePhotos/{uid}/{filename} {
      // Public read — profile photos are visible to everyone
      allow read: if true;

      allow write: if request.auth != null
        && request.auth.uid == uid
        // Maximum 5 MB for profile photos
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif)');

      allow delete: if request.auth != null
        && request.auth.uid == uid;
    }

    // ── Block everything else ─────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
